<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Provident.Foundations.Sql</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <NeutralLanguage>en-US</NeutralLanguage>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <ReadyToRun>true</ReadyToRun>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageId>Provident.Foundations.SqlServer</PackageId>
    <Title>Provident.Foundations SQL Server Framework</Title>
    <Version>0.91.1.0</Version>
    <FileVersion>11.91.1.0</FileVersion>
    <AssemblyVersion>11.91.1.0</AssemblyVersion>
    <Authors>Sam Jones</Authors>
    <Product>Provident Foundations SQL Server Framework</Product>
    <Description>A general-purpose, portable .NET class library for SQL Server database development on .NET 11</Description>
    <Copyright>Copyright © 2024 - 2026 Provident Foundations.</Copyright>
    <PackageProjectUrl>https://samjones.azurewebsites.net</PackageProjectUrl>
    <AssemblyName>Provident.Foundations.Sql.Framework</AssemblyName>
    <AssemblyTitle>Provident.Foundations.Sql.Framework</AssemblyTitle>
    <ApplicationIcon>ProvidentFoundations.ico</ApplicationIcon>
    <PackageIcon>Nuget Package Logo For Applications.png</PackageIcon>
    <RepositoryUrl>https://github.com/Provident-Foundations/Provident-Foundations-Sql-Framework</RepositoryUrl>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ProvidentFoundations.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
	  <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.5.96" />
	  <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.46.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Provident Foundations Framework\Provident.Foundations\Provident.Foundations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Schema\Enumerations\" />
  </ItemGroup>

</Project>
