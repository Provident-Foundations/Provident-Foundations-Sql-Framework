<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <PlatformTarget>x64</PlatformTarget>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <AnalyzeAssembly>True</AnalyzeAssembly>
	  <Platforms>AnyCPU;x64</Platforms>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryType>git</RepositoryType>
	  <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
	  <NeutralLanguage>en-US</NeutralLanguage>
	  <TieredCompilation>true</TieredCompilation>
	  <TieredPGO>true</TieredPGO>
	  <ReadyToRun>true</ReadyToRun>
	  <PackageLicenseFile>License.txt</PackageLicenseFile>
	  <PackageId>Provident.Foundations</PackageId>
	  <Title>Provident.Foundations Framework</Title>
	  <Version>0.91.1.0</Version>
	  <FileVersion>11.91.1.0</FileVersion>
	  <AssemblyVersion>11.91.1.0</AssemblyVersion>
	  <Authors>Sam Jones</Authors>
	  <Product>Provident Foundations Framework</Product>
	  <Description>A general-purpose, portable .NET class library for application development on .NET 11</Description>
	  <Copyright>Copyright © 2024 - 2026 Provident Foundations.</Copyright>
	  <PackageProjectUrl>https://samjones.azurewebsites.net</PackageProjectUrl>
	  <AssemblyName>Provident.Foundations.Framework</AssemblyName>
	  <AssemblyTitle>Provident.Foundations.Framework</AssemblyTitle>
	  <RootNamespace>Provident.Foundations</RootNamespace>
	  <ApplicationIcon>ProvidentFoundations.ico</ApplicationIcon>
	  <PackageIcon>Nuget Package Logo For Applications.png</PackageIcon>
	  <RepositoryUrl>https://github.com/Provident-Foundations/Provident-Foundations-Framework</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Remove="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ProvidentFoundations.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Nuget Package Logo For Applications.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
	<None Include="License.txt" Pack="true" PackagePath="\" />
	<None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Mvvm\" />
  </ItemGroup>
</Project>
